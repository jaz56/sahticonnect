{
  "name": "web-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "openapi-generator-cli generate --generator-key portail && openapi-generator-cli generate --generator-key orchestrateur",
    "generate:graphql": "graphql-codegen --config codegen.ts",
    "generate": "npm run generate:api && npm run generate:graphql",
    "prestart": "npm run generate",
    "start": "ng serve",
    "prebuild": "npm run generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate",
    "test": "ng test --watch=false",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@apollo/client": "^4.3.8",
    "apollo-angular": "^14.2.0",
    "chart.js": "^4.6.2",
    "graphql": "^16.15.0",
    "graphql-ws": "^6.4.3",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-apollo-angular": "^6.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@openapitools/openapi-generator-cli": "^2.43.0",
    "@playwright/test": "^1.65.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}

# Copier ce fichier en .env (ignoré par git) puis choisir les mots de passe :
#   Copy-Item .env.example .env
# Lu automatiquement par docker compose. Les mots de passe des bases ne servent qu'au PREMIER démarrage de
# PostgreSQL (création des utilisateurs) : pour les changer ensuite, docker compose down -v (efface les données).

# Super-utilisateur PostgreSQL (administration uniquement, aucun service ne l'utilise)
POSTGRES_PASSWORD=changer-moi

# Un utilisateur par base (database-per-service)
CNAM_DB_PASSWORD=changer-moi-cnam
PORTAIL_DB_PASSWORD=changer-moi-portail
DASHBOARD_DB_PASSWORD=changer-moi-dashboard
TELEMETRIE_DB_PASSWORD=changer-moi-telemetrie
ORCHESTRATEUR_DB_PASSWORD=changer-moi-orchestrateur

# Ports publiés sur la machine (mêmes ports qu'en local). À changer seulement si un service tourne déjà en local
# sur le même port (mvnw spring-boot:run) ; dans le réseau Docker, les ports internes ne changent pas.
CNAM_PORT=8081
PORTAIL_PORT=8082
DASHBOARD_PORT=8083
ORCHESTRATEUR_PORT=8085
TELEMETRIE_PORT=9090
GATEWAY_PORT=8080

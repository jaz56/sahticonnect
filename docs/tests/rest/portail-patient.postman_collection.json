{
  "info": {
    "name": "SahtiConnect – Portail patient (REST)",
    "description": "Scénario complet du service portail-patient-service : profil → créneaux → RDV → modification → annulation → RDV d'urgence → ambulance → erreurs du contrat.\nÀ exécuter dans l'ordre (Collection Runner) : les identifiants sont passés d'une requête à l'autre par des variables de collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "creneauId",
      "value": ""
    },
    {
      "key": "creneauTeleId",
      "value": ""
    },
    {
      "key": "rdvId",
      "value": ""
    },
    {
      "key": "missionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Profil",
      "item": [
        {
          "name": "Consulter PAT-0001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nom\", () => pm.expect(pm.response.json().nom).to.eql(\"Ben Salah\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/PAT-0001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "PAT-0001"
              ]
            }
          }
        },
        {
          "name": "Modifier les coordonnées",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/PAT-0001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "PAT-0001"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telephone\": \"+216 98 123 456\",\n  \"adresse\": \"12 rue de Marseille, 1000 Tunis\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ordonnances actives",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"au moins une\", () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/PAT-0001/ordonnances?actives=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "PAT-0001",
                "ordonnances"
              ],
              "query": [
                {
                  "key": "actives",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Médecins et créneaux",
      "item": [
        {
          "name": "Médecins (cardiologie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/medecins?specialite=Cardiologie",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medecins"
              ],
              "query": [
                {
                  "key": "specialite",
                  "value": "Cardiologie"
                }
              ]
            }
          }
        },
        {
          "name": "Créneaux PRESENTIEL libres de MED-001",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// prochain jour de consultation (hors dimanche) dans 2 jours au moins",
                  "const d = new Date(); d.setDate(d.getDate() + 2); if (d.getDay() === 0) d.setDate(d.getDate() + 1);",
                  "const jour = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set(\"date\", jour);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"creneauId\", pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/creneaux?medecinId=MED-001&date={{date}}&type=PRESENTIEL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "creneaux"
              ],
              "query": [
                {
                  "key": "medecinId",
                  "value": "MED-001"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "type",
                  "value": "PRESENTIEL"
                }
              ]
            }
          }
        },
        {
          "name": "Créneaux TELECONSULTATION libres de MED-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"creneauTeleId\", pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/creneaux?medecinId=MED-001&date={{date}}&type=TELECONSULTATION",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "creneaux"
              ],
              "query": [
                {
                  "key": "medecinId",
                  "value": "MED-001"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "type",
                  "value": "TELECONSULTATION"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Rendez-vous",
      "item": [
        {
          "name": "Prendre un RDV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"rdvId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rendez-vous",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rendez-vous"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifiantPatient\": \"PAT-0001\",\n  \"medecinId\": \"MED-001\",\n  \"creneauId\": \"{{creneauId}}\",\n  \"type\": \"PRESENTIEL\",\n  \"motif\": \"Contrôle trimestriel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
